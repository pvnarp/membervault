# ============================================================
# Production Environment Variables
# Copy to .env and fill in real values before deploying
# ============================================================

# Database
DATABASE_URL=postgresql://membership_user:STRONG_PASSWORD_HERE@postgres:5432/membership
POSTGRES_USER=membership_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=GENERATE_ANOTHER_64_CHAR_RANDOM_STRING

# Encryption — generate with: openssl rand -hex 32
ENCRYPTION_KEY=GENERATE_64_CHAR_HEX_STRING

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_production_api_key
EMAIL_FROM=noreply@yourdomain.com

# CAPTCHA (Altcha — generate with: openssl rand -hex 32)
ALTCHA_HMAC_KEY=GENERATE_HMAC_KEY

# Redis (strongly recommended for production rate limiting)
REDIS_URL=redis://redis:6379

# App
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
UPLOAD_PATH=/app/uploads
LOG_LEVEL=info

# Domain for Caddy auto-TLS (your actual domain, e.g., members.yourdomain.com)
DOMAIN=yourdomain.com

# Frontend (build-time)
VITE_API_URL=/api/v1
