# Auto detect text files and perform LF normalization
* text=auto

# TypeScript
*.ts text eol=lf
*.tsx text eol=lf

# JavaScript
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# JSON & Config
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Prisma
*.prisma text eol=lf

# Markdown
*.md text eol=lf

# Docker
Dockerfile text eol=lf
*.dockerignore text eol=lf

# Shell
*.sh text eol=lf

# Lock files — don't diff
package-lock.json -diff
