# Database
DATABASE_URL=postgresql://membership_user:your_password@localhost:5432/membership
POSTGRES_USER=membership_user
POSTGRES_PASSWORD=your_password

# Auth
JWT_SECRET=generate-a-64-char-random-string
JWT_REFRESH_SECRET=generate-another-64-char-random-string

# Encryption
ENCRYPTION_KEY=generate-a-64-char-hex-string

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@example.org

# CAPTCHA (Altcha — proof-of-work, self-hosted, no third-party)
# Leave empty in dev to skip validation
ALTCHA_HMAC_KEY=

# Redis (optional — used for rate limiting in production)
# Leave empty to use in-memory rate limiting
REDIS_URL=

# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
UPLOAD_PATH=./uploads
LOG_LEVEL=debug

# Domain (used by Caddy for auto-TLS in production)
DOMAIN=localhost

# Frontend (build-time)
VITE_API_URL=http://localhost:3000/api/v1
