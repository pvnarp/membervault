# =============================================================================
# MemberVault — .gitignore
# =============================================================================

# Environment — never commit secrets
.env
.env.local
.env.production
.env.*.local
!.env.example
!.env.production.example

# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.tsbuildinfo

# Turborepo
.turbo/

# Drizzle generated migrations (regenerate with drizzle-kit generate)
apps/backend/drizzle/

# Uploaded user documents
uploads/

# Test output
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
blob-report/

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pino-pretty.log

# Docker local volumes
postgres-data/
postgres-dev-data/
redis-data/
grafana-data/
caddy-data/
caddy-config/

# Database backups (keep directory via .gitkeep)
backups/*.sql.gz
backups/weekly/

# k6 output
k6-output*.json
k6-summary*.json

# Workspace lock files — only root lock file is tracked
apps/*/package-lock.json
packages/*/package-lock.json

# Temporary
*.tmp
*.temp
.cache/
