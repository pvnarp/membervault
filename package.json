{
    "name": "membership-app",
    "version": "2.0.0",
    "private": true,
    "description": "Multi-tenant membership management system",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "test": "turbo run test",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
        "test:e2e": "npx playwright test --config=e2e/playwright.config.ts",
        "test:e2e:ui": "npx playwright test --config=e2e/playwright.config.ts --ui",
        "test:e2e:docker": "docker compose -f docker-compose.test.yml up --build -d && sleep 5 && BASE_URL=http://localhost npx playwright test --config=e2e/playwright.config.ts; docker compose -f docker-compose.test.yml down",
        "test:load:smoke": "k6 run load-tests/smoke.js",
        "test:load:average": "k6 run load-tests/average.js",
        "test:load:stress": "k6 run load-tests/stress.js",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@playwright/test": "^1.52.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.1",
        "turbo": "^2.9.14",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.56.0"
    },
    "overrides": {
        "glob": "^10.5.0",
        "minimatch": "^10.2.1",
        "webpack": "^5.104.1",
        "tmp": "^0.2.4"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.0"
}
